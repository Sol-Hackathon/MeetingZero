# 어떤 모델을 쓸지: gemini | claude | claude-cli
# 비워두면 아래에 키가 들어 있는 쪽을 자동으로 씁니다 (둘 다 있으면 gemini).
AI_PROVIDER=gemini

# Gemini - https://aistudio.google.com/apikey (무료 등급 있음)
GEMINI_API_KEY=
# 답변 정리(재질문 포함)에 쓰는 모델. 어려운 일이라 기본 모델을 둡니다.
# GEMINI_MODEL=gemini-3.6-flash
# 1라운드 질문 생성만 다른 모델로. 쉬운 일이라 한도가 넉넉한 모델에 맡기면 무료 한도를 아낍니다.
# GEMINI_QUESTION_MODEL=gemini-3.5-flash-lite

# Claude API - https://console.anthropic.com (유료, 선불 크레딧 필요)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Claude Code CLI - 이 PC 에 로그인된 Claude 구독으로 헤드리스 호출. 키 없음, 데모 전용.
# Claude Code 가 로그인된 PC 에서만 돌고 배포는 안 됩니다. 구독 사용량(5시간 창)에서 차감됩니다.
# AI_PROVIDER=claude-cli
# CLAUDE_CLI_MODEL=sonnet      # sonnet | opus | haiku 또는 모델 ID
# CLAUDE_CLI_PATH=             # claude 명령이 PATH 에 없을 때 실행 파일 경로

# 키 없이 UI 흐름만 확인할 때 1 로 설정 (고정된 예시 질문·요약이 나옵니다)
MEETINGLESS_MOCK_AI=0

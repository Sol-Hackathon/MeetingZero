# 어떤 모델을 쓸지: gemini | claude
# 비워두면 아래에 키가 들어 있는 쪽을 자동으로 씁니다 (둘 다 있으면 gemini).
AI_PROVIDER=gemini

# Gemini - https://aistudio.google.com/apikey (무료 등급 있음)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Claude - https://console.anthropic.com (유료, 선불 크레딧 필요)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# 키 없이 UI 흐름만 확인할 때 1 로 설정 (고정된 예시 질문·요약이 나옵니다)
MEETINGLESS_MOCK_AI=0
